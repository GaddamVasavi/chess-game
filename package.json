{
  "name": "chess-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Multiplayer Online Chess Platform with Scalable Cloud-Native DevOps Infrastructure",
  "main": "backend/dist/main.js",
  "workspaces": [
    "frontend/chess-client",
    "backend"
  ],
  "scripts": {
    "start": "npm run start:prod --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend/chess-client",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend/chess-client",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend/chess-client",
    "loc:report": "ts-node scripts/generate-loc-report.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
